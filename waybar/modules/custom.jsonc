{
  "custom/appmenu": {
    "format": "󰣇",
    "tooltip-format": "Open the application launcher",
    "on-click": "rofi --show drun --allow-images --width 450 --height 400 --style ~/.config/wofi/wallust-style.css; hyprctl dispatch focuswindow '^(Wofi)'",
    "on-click-right": "~/.config/notscripter/scripts/keybindings.sh",
    "tooltip": false
  },
  "group/quicklinks": {
    "orientation": "horizontal",
    "modules": [
      "custom/quicklink1",
      "custom/quicklink2",
      "custom/quicklink3"
    ]
  },
  "custom/quicklink1": {
    "format": "󰾔 ",
    "on-click": "qutebrowser",
    "tooltip-format": "Browser"
  },
  "custom/quicklink2": {
    "format": "󰉋 ",
    "on-click": "thunar",
    "tooltip-format": "Filemanager"
  },
  "custom/quicklink3": {
    "format": "󰇮 ",
    "on-click": "qutebrowser 'https://mail.google.com/mail/u/0/#inbox'",
    "tooltip-format": "Thunderbird"
  },
  "group/media": {
    "orientation": "horizontal",
    "modules": [
      "mpd"
    ]
  },
  "mpd": {
    "format": "{stateIcon}",
    "format-disconnected": "{stateIcon} Disconnected",
    "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped",
    "interval": 2,
    "state-icons": {
      "paused": "󰝛 Paused",
      "playing": " Playing"
    },
    "tooltip-format": "{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S})",
    "tooltip-format-disconnected": "MPD (disconnected)",
    "on-click-right": "playerctl play-pause",
    "on-click": "alacritty --class=nebu.music -e rmpc"
  },
  "group/daemons": {
    "orientation": "horizontal",
    "modules": [
      "custom/daemons"
    ]
  },
  "custom/daemons": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/daemons-status.sh",
    "interval": 5,
    "tooltip": true,
    "on-click": "alacritty --class=nebu.system -e systemctl --user status"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/notification": {
    "format": "󰍡",
    "tooltip-format": "Notification Center",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },
  "custom/exit": {
    "format": " ",
    "tooltip-format": "Powermenu",
    "on-click": "wlogout -b 2 -r 50 -c 50",
    "tooltip": false
  }
}
