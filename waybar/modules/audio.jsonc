{
  "group/sound": {
    "orientation": "horizontal",
    "modules": "wireplumber"
  },
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{volume}% {icon} ",
    "format-bluetooth-muted": "  {icon} ",
    "format-muted": " ",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "portable": "",
      "default": [
        " ",
        " ",
        " "
      ]
    },
    "scroll-step": 5
  }
}
